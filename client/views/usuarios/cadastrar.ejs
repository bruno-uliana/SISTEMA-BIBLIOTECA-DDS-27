<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

    <main class="container my-2 flex-grow-1">
        <h1 class="accent fs-6x1"> ESTOU NA PÁGINA DE CADASTRO DE USUÁRIO </h1>

       
       
        <!-- CRIAR O FORMULARIO DE CADASTRO -->
         <div class="d-flex flex-column">
            <!-- ACTION - FALA A ROTA QUE O BOTÃO VAI ENVIAR AS INFORMAÇÕES -->
           <form action="/usuarios/cadastrar" method="post">
                
                <!-- CAXINHA DE NOME -->
                <div class="form-control">
                    <label for="nome"> Nome: </label>
                    <input type="text" name="nome" id="nome" required>
                </div>


                <!-- CAXINHA DE EMAIL -->
                <div class="form-control">
                    <label for="email"> Email: </label>
                    <input type="email" name="email" id="email" required>
                </div>
                
                <!-- CAXINHA DE SENHA -->
                <div class="form-control">
                    <label for="senha"> Senha: </label>
                    <input type="senha" name="senha" id="senha" required>
                </div>

                <!-- CAXINHA DE PERFIL -->
                <div class="form-group">
                    <label for="perfil"> Perfil: </label>
                    <select name="perfil" id="perfil" class="form-control">
                        <option value="adm"> Administrador</option>
                        <option value="bibiotecaria"> Bibiotecaria</option>
                    </select>
                </div>

               <!-- BOTÃO DE ENVIO -->
                   <button type="submit" class="btn-subtle theme-accent mt-3">  Cadastrar </button>
            
            </form>
         </div>
    </main>

<!-- IMPORTAÇÃO DO FOOTER -->
 <%- include('../partials/footer') %>